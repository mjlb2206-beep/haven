{
  "$description": "Haven platform design tokens (v0.1.0-beta). Mirrors the color and text styles in the Framer project.",
  "color": {
    "cream": "#F7F3EA",
    "creamDeep": "#EFE8DA",
    "sage": "#A8B9A0",
    "sageLight": "#E3EADD",
    "deepSage": "#65775F",
    "charcoal": "#252825",
    "mutedText": "#6E736C",
    "coral": "#E98267",
    "coralLight": "#FBE5DD",
    "white": "#FFFFFF",
    "hairline": "rgba(37, 40, 37, 0.08)"
  },
  "font": { "family": "Plus Jakarta Sans" },
  "text": {
    "display":      { "size": [68, 56, 42], "weight": 600, "lineHeight": "1.02em", "tracking": "-0.04em" },
    "heading2":     { "size": [48, 40, 32], "weight": 600, "lineHeight": "1.06em", "tracking": "-0.035em" },
    "heading2Small":{ "size": [32, 30, 26], "weight": 600, "lineHeight": "1.12em", "tracking": "-0.03em" },
    "heading3":     { "size": [22, 21, 20], "weight": 600, "lineHeight": "1.25em", "tracking": "-0.02em" },
    "heading4":     { "size": [16], "weight": 600, "lineHeight": "1.3em" },
    "bodyLarge":    { "size": [18, 17, 16], "weight": 400, "lineHeight": "1.55em" },
    "body":         { "size": [15], "weight": 400, "lineHeight": "1.5em" },
    "uiLabel":      { "size": [14], "weight": 600, "lineHeight": "1.2em" },
    "small":        { "size": [13], "weight": 500, "lineHeight": "1.4em" },
    "eyebrow":      { "size": [12], "weight": 600, "tracking": "0.12em", "transform": "uppercase" },
    "stat":         { "size": [40, 36, 32], "weight": 600, "tracking": "-0.04em" }
  },
  "radius": { "card": "20–28px", "button": "100px", "input": "14–16px" },
  "breakpoints": { "desktop": 1200, "tablet": 810, "phone": 390 }
}
